              <div class="mt-8 lg:mt-14 w-full max-w-2xl opacity-0 fade-in-up" id="notifications-section" style="animation-delay: 0.6s;">
                <div class="bg-white bg-opacity-95 backdrop-blur-sm rounded-lg border border-neutral-200 shadow-lg p-6">
                    <div class="flex items-center justify-between mb-4">
                        <div class="flex items-center space-x-3">
