                  class="font- text-neutral-700 hover:text-blue-700 transition-colors duration-300">Contact</a>
              </div>
            </div>
          </div>
        </header>

        <script>
          // Mobile menu toggle functionality
          document.addEventListener('DOMContentLoaded', function () {
            const mobileMenuButton = document.getElementById('mobile-menu-button');
            const mobileMenu = document.getElementById('mobile-menu');

            mobileMenuButton.addEventListener('click', function () {
              const expanded = this.getAttribute('aria-expanded') === 'true' || false;
              this.setAttribute('aria-expanded', !expanded);

              if (expanded) {
                mobileMenu.classList.add('hidden');
              } else {
                mobileMenu.classList.remove('hidden');
              }
            });

            // Hide menu when clicking on a link (mobile)
            const mobileLinks = mobileMenu.querySelectorAll('a');
            mobileLinks.forEach(link => {
              link.addEventListener('click', function () {
                mobileMenu.classList.add('hidden');
                mobileMenuButton.setAttribute('aria-expanded', 'false');
              });
            });

            // Add scroll event to change header style
            const header = document.getElementById('header');
            window.addEventListener('scroll', function () {
              if (window.scrollY > 10) {
                header.classList.add('shadow');
              } else {
                header.classList.remove('shadow');
              }
            });
          });
        </script>
      </div>

    </div>

        <section id="hero" class="relative overflow-hidden pt-32 pb-20 lg:pt-40 lg:pb-28">
          <!-- Background Image -->
          <div class="absolute inset-0 z-0">
            <img
              src="https://images.unsplash.com/photo-1515923256482-1c04580b477c?crop=entropy&amp;cs=tinysrgb&amp;fit=max&amp;fm=jpg&amp;&amp;ixlib=rb-4.0.3&amp;q=80&amp;w=1080?q=80"
              alt="Modern blue building architecture representing innovation and research"
              onerror="this.onerror=null; this.src='https://placehold.co/1200x800/0c4073/ffffff?text=IITB-Citadel+Securities'"
              class="w-full h-full object-cover opacity-20">
          </div>

          <!-- Animated elements - Floating particles -->
