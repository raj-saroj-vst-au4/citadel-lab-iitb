          <!-- Content Container -->
          <div class="container mx-auto px-4 relative z-10">
            <div class="flex flex-col items-center text-center max-w-4xl mx-auto">
              <!-- Animated Logo (text-based) -->
              <div class="inline-block mb-6 relative">
                <!-- <div class="text-sm tracking-widest text-blue-600 mb-2 opacity-0" id="hero-subtitle-pre"
                  style="opacity: 1; transition: opacity 0.8s ease-out;">PARTNERSHIP FOR EXCELLENCE</div> -->
                <h1
