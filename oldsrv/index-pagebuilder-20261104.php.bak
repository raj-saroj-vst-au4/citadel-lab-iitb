    class="sr-only focus:not-sr-only focus:absolute focus:top-0 focus:left-0 focus:z-50 focus:p-4 focus:bg-white focus:text-black">
    Skip to main content
  </a>

  <!-- Main content area -->
  <main id="main-content" class="flex-1 relative h-full">

    <div id="c0088298-ec0c-4962-b774-833947467d7a" data-section_id="c0088298-ec0c-4962-b774-833947467d7a"
      data-type="content" data-order="0" class=" sectionCode">

      <div id="root">
        <header id="header" class="fixed w-full top-0 z-50 bg-white shadow-sm">
          <div class="container mx-auto px-4 py-3">
            <nav class="flex justify-between items-center">
              <!-- Logo -->
              <div class="flex items-center min-w-0 mr-2">
                <img src="assets/images/iitblogo.png" alt="Logo" class="h-10 mr-2 flex-shrink-0">
                <img src="assets/images/citadellogo.png" alt="Logo" class="h-6 w-auto"
                  style="max-width: min(52vw, 307px); object-fit: contain; object-position: left center;">
              </div>

              <!-- Desktop Navigation -->
              <div class="hidden lg:flex space-x-4">

                <a href="#hero"
                  class="font- text-neutral-700 hover:text-blue-700 transition-colors duration-300">Home</a>

                <a href="#about"
                  class="font- text-neutral-700 hover:text-blue-700 transition-colors duration-300">About</a>

                <!--<a href="#research-areas"
                  class="font- text-neutral-700 hover:text-blue-700 transition-colors duration-300">Research Areas</a>-->

                <a href="#programs"
                  class="font- text-neutral-700 hover:text-blue-700 transition-colors duration-300">Academic
                  Programs</a>

                  <div class="relative group">
                    <button
                      class="font- text-neutral-700 hover:text-blue-700 transition-colors duration-300 flex items-center">
                      Research
                      <svg class="w-4 h-4 ml-1 transform group-hover:rotate-180 transition-transform duration-300" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"></path>
                      </svg>
                    </button>
                    <div class="absolute left-0 mt-2 w-48 bg-white rounded-md shadow-lg opacity-0 invisible group-hover:opacity-100 group-hover:visible transition-all duration-300 z-50">
                      <a href="#research-areas"
                        class="block px-4 py-2 text-sm text-neutral-700 hover:bg-blue-50 hover:text-blue-700 transition-colors duration-300">Research Areas</a>
                      <a href="#research-projects"
                        class="block px-4 py-2 text-sm text-neutral-700 hover:bg-blue-50 hover:text-blue-700 transition-colors duration-300">Research Projects</a>
                    </div>
                  </div>

                <!--<a href="#research-projects"
                    class="font- text-neutral-700 hover:text-blue-700 transition-colors duration-300">Research Projects</a>-->

                  <div class="relative group">
                    <button
                      class="font- text-neutral-700 hover:text-blue-700 transition-colors duration-300 flex items-center">
                      People
                      <svg class="w-4 h-4 ml-1 transform group-hover:rotate-180 transition-transform duration-300" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"></path>
                      </svg>
                    </button>
                    <div class="absolute left-0 mt-2 w-48 bg-white rounded-md shadow-lg opacity-0 invisible group-hover:opacity-100 group-hover:visible transition-all duration-300 z-50">
                      <a href="#people"
                        class="block px-4 py-2 text-sm text-neutral-700 hover:bg-blue-50 hover:text-blue-700 transition-colors duration-300">Faculty</a>
                      <a href="#students"
