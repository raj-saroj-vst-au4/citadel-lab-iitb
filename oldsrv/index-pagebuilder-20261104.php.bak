                    </div>
		    <div class="space-y-4">
        <!-- PhD Fellowship Notification -->
        <div class="program-details-btn group relative overflow-hidden bg-gradient-to-r from-blue-50 to-blue-102 rounded-xl border border-blue-300 shadow-sm hover:shadow-lg transition-all duration-300 cursor-pointer" data-program="graduate">
            <div class="absolute top-0 left-0 w-1.5 h-full bg-gradient-to-b from-blue-700 to-blue-900"></div>
            <div class="flex items-center justify-between p-5 pl-6">
                <div class="flex items-center space-x-4 flex-1">
                    <!-- Icon -->
                    <div class="flex-shrink-0 w-12 h-12 bg-gradient-to-br from-blue-700 to-blue-900 rounded-lg flex items-center justify-center shadow-sm group-hover:scale-110 transition-transform duration-300">
                        <svg class="w-6 h-6 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4"></path>
                        </svg>
