                    loading="lazy">
                </div>

                <div class="p-6">
                  <h3 class="text-xl font-bold text-neutral-900 mb-4">Social Media and IPOs: An Empirical and Mathematical Study</h3>

                  <!-- PI Section with Circular Image -->
                  <a href="https://www.sc.iitb.ac.in/~ankur/" target="_blank" rel="noopener noreferrer">
                    <div class="flex items-center mb-3">
                        <div class="w-12 h-12 rounded-full overflow-hidden border-2 border-blue-500 flex-shrink-0">
                        <img
                            src="assets/images/ankurkulkarni.jpeg"
