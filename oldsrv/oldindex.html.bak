                100: '#e8e8e8',
                200: '#d3d3d3',
                300: '#a3a3a3',
                400: '#737373',
                500: '#525252',
                600: '#404040',
                700: '#262626',
                800: '#171717',
                900: '#0a0a0a',
                950: '#030303',
              },
              secondary: {
