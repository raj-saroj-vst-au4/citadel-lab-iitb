        <script>
          document.addEventListener('DOMContentLoaded', function () {
            // Tabs functionality
            const tabTriggers = document.querySelectorAll('#tabs-nav button');
            const tabPanes = document.querySelectorAll('.tab-pane');

            // Click handlers for tab navigation
            tabTriggers.forEach(trigger => {
              trigger.addEventListener('click', function () {
                // Deactivate all tabs
                tabTriggers.forEach(btn => {
                  btn.classList.remove('text-blue-600', 'border-b-2', 'border-blue-600');
                  btn.classList.add('text-neutral-500');
                  btn.setAttribute('aria-selected', 'false');
                });

                // Activate clicked tab
                this.classList.remove('text-neutral-500');
                this.classList.add('text-blue-600', 'border-b-2', 'border-blue-600');
                this.setAttribute('aria-selected', 'true');

                // Hide all tab panes
                tabPanes.forEach(pane => {
                  pane.classList.add('hidden', 'opacity-0');
                  pane.classList.remove('block', 'opacity-100');
                });

                // Show selected tab pane
                const targetId = this.getAttribute('aria-controls');
                const targetPane = document.getElementById(targetId);
                targetPane.classList.remove('hidden');

                // Trigger animation after a small delay
                setTimeout(() => {
                  targetPane.classList.add('block', 'opacity-100');
                  targetPane.classList.remove('opacity-0');
                  targetPane.style.transition = 'opacity 0.5s ease-out';
                }, 50);
              });
            });

            // Grid item handlers
            const gridItems = document.querySelectorAll('.grid-cols-4 > div');
            gridItems.forEach(item => {
              item.addEventListener('click', function () {
                const tabId = this.getAttribute('data-tab');
                document.getElementById(`${tabId}-trigger`).click();

                // Scroll to tabs section
                document.getElementById('tabs-nav').scrollIntoView({ behavior: 'smooth', block: 'start' });
              });
            });

            // Modal functionality
            const modal = document.getElementById('research-modal');
            const modalContent = document.getElementById('modal-content');
            const modalTitle = document.getElementById('modal-title');
            const modalBody = document.getElementById('modal-content-body');
            const closeModalBtn = document.getElementById('close-modal-btn');
            const closeModalBtn2 = document.getElementById('close-modal-btn-2');
            let lastFocusedButton = null;

            // Modal content templates
            const modalContentTemplates = {
              'quant': {
                title: 'Quantitative Finance Research',
                content: `
            <p class="mb-4">The IITB-Citadel Securities Quantitative Research Lab is at the forefront of quantitative finance research, developing sophisticated mathematical models and statistical methodologies for optimizing investment strategies and financial decision-making.</p>
            
            <h4 class="text-xl font-semibold mt-6 mb-3">Key Research Focus Areas:</h4>
            <ul class="space-y-3 mb-6">
              <li class="flex items-start">
                <svg class="w-5 h-5 text-blue-600 mt-1 mr-2" fill="currentColor" viewBox="0 0 20 20" xmlns="http://www.w3.org/2000/svg">
                  <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"></path>
                </svg>
                <div>
                  <strong>Mathematical Modeling:</strong> Developing sophisticated mathematical frameworks to model financial markets, asset pricing, and portfolio optimization.
                </div>
              </li>
              <li class="flex items-start">
                <svg class="w-5 h-5 text-blue-600 mt-1 mr-2" fill="currentColor" viewBox="0 0 20 20" xmlns="http://www.w3.org/2000/svg">
                  <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"></path>
                </svg>
                <div>
                  <strong>Statistical Arbitrage:</strong> Researching novel statistical techniques to identify and exploit market inefficiencies across various asset classes and markets.
                </div>
              </li>
              <li class="flex items-start">
                <svg class="w-5 h-5 text-blue-600 mt-1 mr-2" fill="currentColor" viewBox="0 0 20 20" xmlns="http://www.w3.org/2000/svg">
                  <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"></path>
                </svg>
                <div>
                  <strong>Derivative Pricing:</strong> Advancing models for pricing complex derivatives and structured products in the Indian financial markets context.
                </div>
              </li>
            </ul>
            
            <p class="mb-4">Our quantitative finance research team collaborates closely with industry partners to ensure that theoretical advances are translated into practical applications that address real-world financial challenges.</p>
          `
              },
              'algo': {
                title: 'Algorithmic Trading Research',
                content: `
            <p class="mb-4">The algorithmic trading team at IITB-Citadel Securities Quantitative Research Lab focuses on developing cutting-edge trading algorithms and execution strategies that operate at high efficiency across diverse market conditions.</p>
            
            <h4 class="text-xl font-semibold mt-6 mb-3">Key Research Focus Areas:</h4>
            <ul class="space-y-3 mb-6">
              <li class="flex items-start">
                <svg class="w-5 h-5 text-blue-600 mt-1 mr-2" fill="currentColor" viewBox="0 0 20 20" xmlns="http://www.w3.org/2000/svg">
                  <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"></path>
                </svg>
                <div>
                  <strong>High-Frequency Trading Systems:</strong> Researching ultra-low latency systems and algorithms capable of making trading decisions in microseconds while maintaining market fairness.
                </div>
              </li>
              <li class="flex items-start">
                <svg class="w-5 h-5 text-blue-600 mt-1 mr-2" fill="currentColor" viewBox="0 0 20 20" xmlns="http://www.w3.org/2000/svg">
                  <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"></path>
                </svg>
                <div>
                  <strong>Market Microstructure Analysis:</strong> Studying the dynamics of order books, market impact, and liquidity formation in Indian markets to improve execution strategies.
                </div>
              </li>
              <li class="flex items-start">
                <svg class="w-5 h-5 text-blue-600 mt-1 mr-2" fill="currentColor" viewBox="0 0 20 20" xmlns="http://www.w3.org/2000/svg">
                  <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"></path>
                </svg>
                <div>
                  <strong>Trading Infrastructure:</strong> Designing robust, high-performance computing systems optimized for financial applications and algorithmic trading.
                </div>
              </li>
            </ul>
            
            <p class="mb-4">Through a combination of academic rigor and industry insight, our algorithmic trading research aims to enhance market efficiency and provide innovative solutions for executing complex trading strategies.</p>
          `
              },
              'fintech': {
                title: 'Financial Technology Research',
                content: `
            <p class="mb-4">Our financial technology research team explores innovative applications of emerging technologies to revolutionize financial services, increase efficiency, and expand access to financial markets.</p>
            
            <h4 class="text-xl font-semibold mt-6 mb-3">Key Research Focus Areas:</h4>
            <ul class="space-y-3 mb-6">
              <li class="flex items-start">
                <svg class="w-5 h-5 text-blue-600 mt-1 mr-2" fill="currentColor" viewBox="0 0 20 20" xmlns="http://www.w3.org/2000/svg">
                  <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"></path>
                </svg>
                <div>
                  <strong>Blockchain Applications:</strong> Investigating practical applications of blockchain and distributed ledger technologies for improving clearing and settlement systems, enhancing transparency, and reducing counterparty risk.
                </div>
              </li>
              <li class="flex items-start">
                <svg class="w-5 h-5 text-blue-600 mt-1 mr-2" fill="currentColor" viewBox="0 0 20 20" xmlns="http://www.w3.org/2000/svg">
                  <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"></path>
                </svg>
                <div>
                  <strong>AI in Finance:</strong> Developing advanced machine learning models for credit scoring, fraud detection, customer service, and personalized financial recommendations.
                </div>
              </li>
              <li class="flex items-start">
                <svg class="w-5 h-5 text-blue-600 mt-1 mr-2" fill="currentColor" viewBox="0 0 20 20" xmlns="http://www.w3.org/2000/svg">
                  <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"></path>
                </svg>
                <div>
                  <strong>Digital Financial Inclusion:</strong> Creating innovative solutions to extend financial services to underbanked populations leveraging mobile technology and digital payment systems.
                </div>
              </li>
            </ul>
            
            <p class="mb-4">By bridging the gap between technological innovation and financial services, our fintech research aims to create more efficient, accessible, and secure financial systems for India's dynamic economy.</p>
          `
              },
              'risk': {
                title: 'Risk Analytics Research',
                content: `
            <p class="mb-4">The risk analytics team develops advanced methodologies for identifying, measuring, and managing financial risks across market, credit, and operational domains.</p>
            
            <h4 class="text-xl font-semibold mt-6 mb-3">Key Research Focus Areas:</h4>
            <ul class="space-y-3 mb-6">
              <li class="flex items-start">
                <svg class="w-5 h-5 text-blue-600 mt-1 mr-2" fill="currentColor" viewBox="0 0 20 20" xmlns="http://www.w3.org/2000/svg">
                  <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"></path>
                </svg>
                <div>
                  <strong>Predictive Risk Modeling:</strong> Building sophisticated models to forecast market volatility, identify potential stress points, and predict emerging risks in financial markets.
                </div>
              </li>
              <li class="flex items-start">
                <svg class="w-5 h-5 text-blue-600 mt-1 mr-2" fill="currentColor" viewBox="0 0 20 20" xmlns="http://www.w3.org/2000/svg">
                  <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"></path>
                </svg>
                <div>
                  <strong>Systemic Risk Analysis:</strong> Developing frameworks to monitor and assess systemic risks in interconnected financial networks, with a focus on the Indian financial system.
                </div>
              </li>
              <li class="flex items-start">
                <svg class="w-5 h-5 text-blue-600 mt-1 mr-2" fill="currentColor" viewBox="0 0 20 20" xmlns="http://www.w3.org/2000/svg">
                  <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"></path>
                </svg>
                <div>
                  <strong>Stress Testing Methodologies:</strong> Creating comprehensive stress testing frameworks to evaluate the resilience of financial institutions under various adverse scenarios.
                </div>
              </li>
            </ul>
            
            <p class="mb-4">Our risk analytics research combines advanced statistical techniques with domain expertise to help financial institutions and regulators better understand, quantify, and manage complex financial risks.</p>
          `
              }
            };

            // Function to open modal
            function openModal(type) {
              const modalData = modalContentTemplates[type];
              if (!modalData) return;

              // Set modal content
              modalTitle.textContent = modalData.title;
              modalBody.innerHTML = modalData.content;

              // Show the modal container
              modal.classList.remove('hidden');
              document.body.style.overflow = 'hidden'; // Prevent scrolling

              // Animate in the content
              setTimeout(() => {
                modalContent.style.opacity = '1';
                modalContent.style.transform = 'scale(1)';
              }, 50);

              // Set ARIA states
              modal.setAttribute('aria-hidden', 'false');

              // Set focus to the modal
              closeModalBtn.focus();
            }

            // Function to close modal
            function closeModal() {
              // Animate out the content
              modalContent.style.opacity = '0';
              modalContent.style.transform = 'scale(0.95)';

              // Hide the modal container after animation completes
              setTimeout(() => {
                modal.classList.add('hidden');
                document.body.style.overflow = ''; // Restore scrolling
              }, 300);

              // Set ARIA states
              modal.setAttribute('aria-hidden', 'true');

              // Return focus to button that opened modal
              if (lastFocusedButton) {
                lastFocusedButton.focus();
              }
            }

            // Learn more button click handlers
            document.getElementById('learn-more-quant').addEventListener('click', function () {
              lastFocusedButton = this;
              openModal('quant');
            });

            document.getElementById('learn-more-algo').addEventListener('click', function () {
              lastFocusedButton = this;
              openModal('algo');
            });

            document.getElementById('learn-more-fintech').addEventListener('click', function () {
              lastFocusedButton = this;
              openModal('fintech');
            });

            document.getElementById('learn-more-risk').addEventListener('click', function () {
              lastFocusedButton = this;
              openModal('risk');
            });

            // Event listeners for closing modal
            closeModalBtn.addEventListener('click', closeModal);
            closeModalBtn2.addEventListener('click', closeModal);

            // Close when clicking outside of modal content
            modal.addEventListener('click', (e) => {
              if (e.target === modal) {
                closeModal();
              }
            });

            // Close on escape key
            document.addEventListener('keydown', (e) => {
              if (e.key === 'Escape' && !modal.classList.contains('hidden')) {
                closeModal();
              }
            });

            // Trap focus inside modal
            modal.addEventListener('keydown', function (e) {
              if (e.key === 'Tab') {
                const focusable = modal.querySelectorAll('button, [href], input, select, textarea, [tabindex]:not([tabindex="-1"])');
                const firstFocusable = focusable[0];
                const lastFocusable = focusable[focusable.length - 1];

                if (e.shiftKey && document.activeElement === firstFocusable) {
                  e.preventDefault();
                  lastFocusable.focus();
                } else if (!e.shiftKey && document.activeElement === lastFocusable) {
                  e.preventDefault();
                  firstFocusable.focus();
                }
              }
            });

            // Start with the first tab active
            document.getElementById('tab-1-trigger').click();
          });
        </script>
      </div>

    </div>

