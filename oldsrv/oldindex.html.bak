          </div>
        </section>

        <!-- Program Details Modal -->
        <div id="programModal" class="fixed inset-0 z-50 overflow-y-auto hidden" aria-modal="true" aria-hidden="true">
          <div class="fixed inset-0 bg-black bg-opacity-50 transition-opacity" id="modalOverlay"></div>
          <div class="flex items-center justify-center min-h-screen px-4 pt-4 pb-20 text-center sm:block">
            <div
              class="inline-block align-bottom bg-white rounded-lg text-left overflow-hidden shadow-xl transform transition-all sm:my-8 sm:align-middle sm:max-w-2xl sm:w-full p-6 sm:p-8"
              role="dialog" aria-modal="true">
              <!-- Close button -->
              <button onclick="closeModal()"
                class="absolute top-4 right-4 text-neutral-500 hover:text-neutral-700 focus:outline-none">
                <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"
                  xmlns="http://www.w3.org/2000/svg">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path>
                </svg>
              </button>

              <!-- Modal content will be dynamically populated -->
              <div id="modalContent" class="mt-3">
                <h3 id="modalTitle" class="text-2xl font-bold text-neutral-900 mb-4">Program Details</h3>
                <div id="modalBody" class="text-neutral-600"></div>
              </div>
            </div>
          </div>
        </div>
      </div>

      <script>
        function showTab(tab) {
          document.querySelectorAll('.tab-content').forEach(el => el.classList.add('hidden'));
          document.getElementById(tab).classList.remove('hidden');
        }

        // Close modal function
        function closeModal() {
          console.log("closing triggered")
          document.getElementById('programModal').classList.add('hidden');
          document.body.classList.remove('overflow-hidden');
        }

        document.addEventListener('DOMContentLoaded', function () {


          // Animation for program cards
          const programCards = document.querySelectorAll('#programs .rounded-lg.shadow-md');

          const observer = new IntersectionObserver((entries) => {
            entries.forEach((entry, index) => {
              if (entry.isIntersecting) {
                setTimeout(() => {
                  entry.target.classList.add('opacity-100');
                }, index * 150);
              }
            });
          }, { threshold: 0.1 });

          programCards.forEach((card) => {
            card.classList.add('opacity-0', 'transition-opacity', 'duration-500');
            observer.observe(card);
          });

          // Modal functionality
          const modal = document.getElementById('programModal');
          const modalOverlay = document.getElementById('modalOverlay');
          const modalCloseBtn = document.getElementById('programModalCloseBtn');


          const modalTitle = document.getElementById('modalTitle');
          const modalBody = document.getElementById('modalBody');
          const programDetailsBtns = document.querySelectorAll('.program-details-btn');
          const learnMoreBtn = document.getElementById('learnMoreBtn');
          const programApplyBtn = document.getElementById('programApplyBtn');


          // Program details content
          const programDetails = {
            undergraduate: {
              title: "Undergraduate Research Program",
              content: `
          <p class="mb-4">The Undergraduate Research Program at IITB-Citadel Securities Quantitative Research Lab provides early-career students with hands-on experience in quantitative finance and algorithmic trading.</p>
          
          <h4 class="text-lg font-semibold text-neutral-900 mt-6 mb-3">Program Benefits</h4>
          <ul class="space-y-2 mb-6 list-disc pl-5">
            <li>Access to state-of-the-art research tools and datasets</li>
            <li>Mentorship from leading researchers and industry professionals</li>
            <li>Research stipends for selected projects</li>
            <li>Opportunities to contribute to published research</li>
          </ul>
          
          <h4 class="text-lg font-semibold text-neutral-900 mt-6 mb-3">Eligibility Requirements</h4>
          <ul class="space-y-2 mb-6 list-disc pl-5">
            <li>Current undergraduate student in Mathematics, Computer Science, Finance, or related field</li>
            <li>Strong quantitative skills and programming knowledge (Python/R/C++)</li>
            <li>Interest in financial markets and algorithmic trading</li>
          </ul>
          
          <h4 class="text-lg font-semibold text-neutral-900 mt-6 mb-3">Application Timeline</h4>
          <p>Applications for the next cohort are open from August 15 to September 30. Program begins in January 2024.</p>
        `
            },
            graduate: {
              title: "Ph.D. Fellowship",
              content: `
          <p class="mb-4">The Lab supports highly motivated Ph.D. students and Post-Doctoral Fellows (PDFs). The Ph.D. students will receive competitive monthly fellowship and annual research grant of ₹ 100,000 to cover research related expenses. The PDFs will receive monthly salary as per existing institute rules in addition to campus housing subject to availability.</p>
          
          <h4 class="text-lg font-semibold text-neutral-900 mt-6 mb-3">The Benefits</h4>
          <ul class="space-y-2 mb-6 list-disc pl-5">
            <li>Funding: The fellowship covers tuition, research related expenses, and living costs</li>
            <li>Annual Research Grants: To cover research related expenses and conference travel.</li>
            <li>Professional Development: Access to workshops, seminars, and support from industry leaders.</li>
            <li>Mentorship: Guidance from experienced faculty members and industry professionals</li>
          </ul>
          <h4 class="text-lg font-semibold text-neutral-900 mt-6 mb-3">Eligibility Requirement (At least one)</h4>
          <div class="mb-6">
            <div class="flex space-x-4 border-b">
              <button id="tab-indian" onclick="showTab('indian')" class="tab-btn py-2 px-4 font-semibold text-blue-600 border-b-2 border-blue-600">Indian Candidates</button>
              <button id="tab-foreign" onclick="showTab('foreign')" class="tab-btn py-2 px-4 font-semibold">Foreign Candidates</button>
            </div>

            <div id="indian" class="tab-content">
              <ul class="space-y-2 mt-3 mb-2 list-disc pl-5">
                <li>Four year Bachelor in any discipline with 60% marks/6.5 CPI (55%/6.0 CPI for SC/ST) and at least two years work experience.</li>
                <li>Master in any discipline (MBA/M.Tech./M.S./M.Sc./M.A./M.Com./MCA/LLM/M.Pharm./M.Phil., etc.) or 2 year PG Diploma in Management from institutions/universities</li>
                <li>Executive MBA of at least one year duration from IITs/IIMs</li>
                <li>CA/CMA/CS with 60%/6.5 CPI (55%/6.0 CPI for SC/ST) in the preceding degree/Bachelor's (B.Sc./B.Com./BA)</li>
              </ul>
              <br>
              <p>Research Proposal: A detailed research proposal covering introduction, literature review, research gaps, research objectives/ questions / hypotheses, research design(variables, data, period, methodology, etc.) should be submitted along with the application.</p >
              <br>
              <p class="font-semibold">Applications without research proposal will not be considered.</p>
              <br>
              <p>Research Interest: A demonstrated interest or experience in quantitative finance, or related areas is desirable</p>

              <div class="mt-8 flex justify-end">
                  <button id="modalApplyBtn"
                    onclick="window.location.href='https://portal.iitb.ac.in/phdapp/phdAdmissionLinks.jsp'"
                    class="px-6 py-3 bg-blue-600 text-white font-semibold rounded-lg hover:bg-blue-700 transition-all mr-4">
                    Apply
                  </button>
                  <button onclick="closeModal()"
                    class=" px-6 py-3 bg-neutral-200 text-neutral-700 font-semibold rounded-lg hover:bg-neutral-300 transition-all">
                    Close
                  </button>
                </div>
            </div>

            <div id="foreign" class="tab-content hidden">
              <ul class="space-y-2 mt-3 mb-2 list-disc pl-5">
                <li>Four year Bachelor degree with 60% marks or 6.5 CPI and two years work experience OR Masters in any discipline with 60% marks or 6.5 CPI</li>
                <li>The Candidate should have valid TOEFL score</li>
              </ul>
              <br>
              <p>Research Proposal: A detailed research proposal covering introduction, literature review, research gaps, research objectives/ questions / hypotheses, research design(variables, data, period, methodology, etc.) should be submitted along with the application.</p >
              <br>
              <p class="font-semibold">Applications without research proposal will not be considered.</p>
              <br>
              <p>Research Interest: A demonstrated interest or experience in quantitative finance, or related areas is desirable</p>

              <div class="mt-8 flex justify-end">
                  <button id="modalApplyBtn"
                    onclick="window.location.href='http://www.ir.iitb.ac.in/?page_id=26'"
                    class="px-6 py-3 bg-blue-600 text-white font-semibold rounded-lg hover:bg-blue-700 transition-all mr-4">
                    Apply
                  </button>
                  <button onclick="closeModal()"
                    class="px-6 py-3 bg-neutral-200 text-neutral-700 font-semibold rounded-lg hover:bg-neutral-300 transition-all">
                    Close
                  </button>
                </div>
            </div>
          </div>`},
            postdoc: {
              title: "Post-Doctoral Research Position",
              content: `
          <p class="mb-4">The tenure of the Post-Doctoral Fellowships (PDF) is generally for two years (initially for one year and extendable for another year, subject to a satisfactory performance in the first year). There is a possibility of extension for the third year in exceptional cases.</p>
          
          <h4 class="text-lg font-semibold text-neutral-900 mt-6 mb-3">Program Benefits</h4>
          <ul class="space-y-2 mb-6 list-disc pl-5">
            <li>Consolidated salary of Rs. 80,000/- per month with HRA</li>
            <li>Annual research grant of ₹ 100,000 to cover research related expenses.</li>
          </ul>
          
          <h4 class="text-lg font-semibold text-neutral-900 mt-6 mb-3">Eligibility Requirements</h4>
          <ul class="space-y-2 mb-6 list-disc pl-5">
            <li>The eligible candidates include those with doctorate degree (Ph.D. or equivalent title) in the relevant area with demonstrated ability or promise of high-quality research published in reputed journals.</li>
            <li>Candidates should be preferably below 32 years of age.</li>
          </ul>
          
          <h4 class="text-lg font-semibold text-neutral-900 mt-6 mb-3">Responsibilities and Privileges</h4>
          <ul class="space-y-2 mb-6 list-disc pl-5">
            <li>A PDF will have a mentor whose area is closest to that of the Fellow.</li>
            <li>In addition to research, the Head of the Academic units may assign reasonable academic/administrative tasks depending on the need.</li>
            <li>Financial support is provided for one international conference during the tenure of the fellowship for the presentation of their research work done at IIT Bombay.</li>
            <li>Support for one national conference per year is also provided.</li>
          </ul>
        `
            },
            featured: {
              title: "Quantitative Finance Research Initiative",
              content: `
          <p class="mb-4">Our flagship program spans all educational levels, providing participants with hands-on experience in cutting-edge financial models and algorithmic trading systems.</p>
          
          <h4 class="text-lg font-semibold text-neutral-900 mt-6 mb-3">Program Overview</h4>
          <p class="mb-4">The Quantitative Finance Research Initiative integrates education, research, and industry application to create a comprehensive learning environment that prepares participants for leadership in quantitative finance.</p>
          
          <h4 class="text-lg font-semibold text-neutral-900 mt-6 mb-3">Key Components</h4>
          <ul class="space-y-2 mb-6 list-disc pl-5">
            <li>Core curriculum in mathematical finance, stochastic calculus, and computational methods</li>
            <li>Research projects addressing real-world financial challenges</li>
            <li>Industry mentorship from Citadel Securities professionals</li>
            <li>Access to financial datasets and high-performance computing resources</li>
            <li>Regular workshops and seminars with leading financial researchers</li>
          </ul>
          
          <h4 class="text-lg font-semibold text-neutral-900 mt-6 mb-3">Participant Eligibility</h4>
          <p class="mb-4">Open to undergraduate students, graduate researchers, and post-doctoral scholars with strong quantitative backgrounds and interest in financial markets.</p>
          
          <h4 class="text-lg font-semibold text-neutral-900 mt-6 mb-3">Application Process</h4>
          <p>Applications require academic records, research statement, letter of recommendation, and demonstration of quantitative skills. Selected candidates will be invited for an interview.</p>
        `
            }
          };

          // Open modal with specific program details
          function openModal(programType) {
            // Set modal content based on program type
            const program = programDetails[programType];
            modalTitle.textContent = program.title;
            modalBody.innerHTML = program.content;

            // Show modal
            modal.classList.remove('hidden');
            document.body.classList.add('overflow-hidden');

            // Focus on close button
            setTimeout(() => {
              modalCloseBtn.focus();
            }, 100);
          }

          // Event listeners for opening modal
          programDetailsBtns.forEach(btn => {
            btn.addEventListener('click', function () {
              const programType = this.getAttribute('data-program');
              openModal(programType);
            });
          });

          learnMoreBtn.addEventListener('click', function () {
            openModal('featured');
          });

          programApplyBtn.addEventListener('click', function () {
            openModal('featured');
          });

          // Event listeners for closing modal
          modalCloseBtn.addEventListener('click', closeModal);

          modalOverlay.addEventListener('click', closeModal);

          document.querySelectorAll('#modalCloseBtn2').forEach(btn => {
            btn.addEventListener('click', closeModal);
          });

          // Close on ESC key
          document.addEventListener('keydown', function (e) {
            if (e.key === 'Escape' && !modal.classList.contains('hidden')) {
              console.log("excape pressed")
              closeModal();
            }
          });

          // Trap focus in modal
          modal.addEventListener('keydown', function (e) {
            if (e.key === 'Tab') {
              const focusableElements = modal.querySelectorAll('button, [href], input, select, textarea, [tabindex]:not([tabindex="-1"])');
              const firstElement = focusableElements[0];
              const lastElement = focusableElements[focusableElements.length - 1];

              if (e.shiftKey) {
                if (document.activeElement === firstElement) {
                  lastElement.focus();
                  e.preventDefault();
                }
              } else {
                if (document.activeElement === lastElement) {
                  firstElement.focus();
                  e.preventDefault();
                }
              }
            }
          });
        });
        function showTab(tab) {
          document.querySelectorAll('.tab-content').forEach(el => el.classList.add('hidden'));
          document.getElementById(tab).classList.remove('hidden');
          document.querySelectorAll('.tab-btn').forEach(btn => btn.classList.remove('text-blue-600', 'border-b-2', 'border-blue-600'));
          document.getElementById('tab-' + tab).classList.add('text-blue-600', 'border-b-2', 'border-blue-600');
        }
      </script>

    </div>

    <div id="3a7da2c6-972b-489f-8fde-601de2715f79" data-section_id="3a7da2c6-972b-489f-8fde-601de2715f79"
      data-type="content" data-order="7" class=" sectionCode">

      <div id="root">
        <section id="people" class="py-16 px-4 sm:px-6 lg:px-8 bg-neutral-50">
          <div class="max-w-7xl mx-auto">
            <!-- Section Header -->
            <div class="text-center mb-12">
              <h2 class="text-3xl sm:text-4xl font-bold text-neutral-900 mb-4">People</h2>
              <!-- <p class="text-lg text-neutral-600 max-w-3xl mx-auto">Voices from our collaborative ecosystem celebrating
                the impact of the IITB-Citadel Securities partnership</p> -->
            </div>

            <!-- Featured Testimonial -->
            <div class="bg-white rounded-xl shadow-lg p-8 mb-12 relative overflow-hidden">
              <div class="absolute top-0 left-0 w-full h-1 bg-gradient-to-r from-blue-500 to-blue-700"></div>
              <div class="absolute top-0 right-0 p-8 text-neutral-200 opacity-10">
                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" class="w-24 h-24">
                  <path fill-rule="evenodd"
                    d="M4.804 21.644A6.707 6.707 0 006 21.75a6.721 6.721 0 006.75-6.75v-2.625c0-1.936-.324-3.192-1.096-4.147C10.732 7.207 9.366 6.75 7.875 6.75A6.721 6.721 0 001.125 13.5c0 1.851.753 3.529 1.97 4.743a6.7 6.7 0 001.709 1.202A6.158 6.158 0 000 21.75h1.5c0-2.285 1.067-4.325 2.75-5.662A6.713 6.713 0 013 13.5c0-2.017.894-3.827 2.312-5.062a6.078 6.078 0 00-1.008 3.312v2.625c0 1.519.514 2.77 1.359 3.686.844.915 2.01 1.439 3.339 1.439.75 0 1.482-.172 2.138-.493a6.696 6.696 0 01-6.336 4.743z"
                    clip-rule="evenodd"></path>
                  <path fill-rule="evenodd"
                    d="M19.125 6.75c-1.999 0-3.845.892-5.076 2.312a6.719 6.719 0 00-2.048-1.313A6.714 6.714 0 0119.125 3h1.5c0 1.884-.761 3.589-1.993 4.829a6.411 6.411 0 001.502-.579A6.721 6.721 0 0123.25 13.5c0 1.245-.275 2.429-.773 3.486a6.75 6.75 0 01-1.225 3.663A6.73 6.73 0 0119.125 24h-1.5a6.721 6.721 0 01-6.75-6.75v-2.625c0-1.936.324-3.192 1.096-4.147C12.893 9.328 14.259 8.75 15.75 8.75a6.721 6.721 0 016.75 6.75c0 1.593-.58 3.034-1.522 4.125a6.749 6.749 0 01-1.072-3.676 6.159 6.159 0 01.652-2.777 4.708 4.708 0 00-.818.839 4.73 4.73 0 00-.875 2.75v2.625c0 1.519-.514 2.77-1.359 3.686-.844.915-2.01 1.439-3.339 1.439a4.707 4.707 0 01-3.339-1.439c-.845-.915-1.359-2.167-1.359-3.686v-2.625c0-1.519.514-2.77 1.359-3.686.844-.915 2.01-1.439 3.339-1.439.75 0 1.482.172 2.138.493a6.696 6.696 0 00-6.336-4.743z"
                    clip-rule="evenodd"></path>
                </svg>
              </div>

              <div class="md:flex items-center gap-8">
                <div class="md:w-1/3 mb-6 md:mb-0">
                  <div
                    class="relative aspect-square w-64 h-64 mx-auto overflow-hidden rounded-full border-4 border-neutral-100 shadow-md">
                    <img src="assets/images/sudeep.jpg" alt="Professional portrait of financial researcher"
                      class="w-full h-full object-cover"
                      onerror="this.onerror=null; this.src='https://placehold.co/400x400'" loading="lazy">
                  </div>
                </div>

                <div class="md:w-2/3">
                  <p class="text-neutral-700 text-lg italic mb-6">"Prof. Sudeep R. Bapat is an Assistant Professor in the Decision Sciences area at the Shailesh J.
Mehta School of Management, Indian Institute of Technology Bombay. He had his schooling
and undergraduate education in New Delhi. He obtained his Bachelor’s degree in statistics
from the University of Delhi, a Master’s in Science in applied statistics and informatics from
the Indian Institute of Technology, Bombay and Ph.D. from the University of Connecticut, USA
in 2017. His thesis mainly concentrates on estimation problems under a sequential sampling
strategy, which is beneficial under many practical real-world examples such as health studies,
ecology, and finance. He later worked as a Visiting Assistant Professor in the Probability and
Statistics Department of the University of California, Santa Barbara, and as an Assistant
Professor at the Indian Institute of Management, Indore. His current research interests extend
to other areas such as time series, censoring, change point detection, statistical psychology,
statistical finance etc. Prof. Bapat is currently also an associated faculty with the Centre for
Machine Intelligence and Data Science, the FedEX Centre for Advanced Logistics and Focused
Analytics, the National Disease Modelling Consortium, and the Centre for Defence Technology
Innovations and Strategies at IIT Bombay. He has presented talks as well as chaired and
organized sessions in many reputed national and international conferences in statistics, over
the years. He has written and published over 50 research papers in leading journals of the
field"</p>
                  <div>
                    <h4 class="text-xl font-bold text-neutral-900">Prof. Sudeep Bapat</h4>
                    <p class="text-blue-600">Professor-In-Charge, IIT Bombay-Citadel Securities Quantitative Research
                      Lab</p>
                    <p class="text-neutral-600">Assistant Professor, Shailesh J. Mehta School of Management, IIT Bombay
                    </p>
                    <!-- <p class="text-neutral-600">Head, Motilal Oswal Centre for Capital Markets</p> -->
                  </div>
                </div>
              </div>
            </div>

            <!-- Testimonial Cards Grid -->
            <div class="grid md:grid-cols-2 gap-8 mb-16">
              <!-- Testimonial 1 -->
