      <script>
        document.addEventListener("DOMContentLoaded", function () {
          const featureCards = document.querySelectorAll('#collaboration .bg-white.p-6');

          const featureObserver = new IntersectionObserver((entries) => {
            entries.forEach((entry, index) => {
              if (entry.isIntersecting) {
                setTimeout(() => {
                  entry.target.classList.add('opacity-100');
                }, index * 150);
                featureObserver.unobserve(entry.target);
              }
            });
          }, { threshold: 0.2 });

          featureCards.forEach((card) => {
            card.classList.add('opacity-0', 'transition-opacity', 'duration-500');
            featureObserver.observe(card);
          });

          const quoteSection = document.querySelector('#collaboration .bg-neutral-800.text-white');
          const quoteObserver = new IntersectionObserver((entries) => {
            entries.forEach((entry) => {
              if (entry.isIntersecting) {
                entry.target.classList.add('animate-quote');
                quoteObserver.unobserve(entry.target);
              }
            });
          }, { threshold: 0.3 });

          if (quoteSection) {
            quoteSection.classList.add('opacity-0', 'transition-all', 'duration-1000');
            quoteObserver.observe(quoteSection);
          }

          const style = document.createElement('style');
          style.textContent = `
    @keyframes quoteAppear {
      0% { opacity: 0; transform: translateY(20px); }
      100% { opacity: 1; transform: translateY(0); }
    }
    .animate-quote {
      animation: quoteAppear 0.8s forwards ease-out;
    }
  `;
          document.head.appendChild(style);
        });
      </script>

    </div> -->

